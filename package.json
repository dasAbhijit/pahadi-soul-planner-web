{
  "name": "pahadi-soul-planner-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pahadi Soul Planner as an installable web app (PWA). Same rules as the iPhone and Android apps.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/make-sw.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/two-phones.mjs",
    "tour": "node e2e/tour.mjs"
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
